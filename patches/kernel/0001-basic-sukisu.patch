diff --git a/kernel/reboot.c b/kernel/reboot.c
index 19f89c074..7c811d351 100644
--- a/kernel/reboot.c
+++ b/kernel/reboot.c
@@ -312,6 +312,15 @@ SYSCALL_DEFINE4(reboot, int, magic1, int, magic2, unsigned int, cmd,
 	char buffer[256];
 	int ret = 0;
 
+#ifdef CONFIG_KSU
+	extern int ksu_handle_sys_reboot(int, int, unsigned int,
+				       void __user **);
+
+	/* KSU_INSTALL_MAGIC1/2 from the pinned builtin driver's UAPI. */
+	if ((u32)magic1 == 0xDEADBEEF && (u32)magic2 == 0xCAFEBABE)
+		return ksu_handle_sys_reboot(magic1, magic2, cmd, &arg);
+#endif
+
 	/* We only trust the superuser with rebooting the system. */
 	if (!ns_capable(pid_ns->user_ns, CAP_SYS_BOOT))
 		return -EPERM;

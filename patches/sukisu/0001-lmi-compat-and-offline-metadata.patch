diff --git a/kernel/preinit/runner/compat/linux/mount.h b/kernel/preinit/runner/compat/linux/mount.h
new file mode 100644
index 00000000..08010347
--- /dev/null
+++ b/kernel/preinit/runner/compat/linux/mount.h
@@ -0,0 +1,41 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * Minimal <linux/mount.h> for the SukiSU preinit runner build on 4.19.
+ *
+ * The vendored nolibc sys/mount.h includes <linux/mount.h> for the MS_*
+ * flags, which 4.19 does not ship in uapi. The mount constants below are
+ * ancient, stable ABI values; the runner does not currently use them but
+ * the wrapper must still compile.
+ */
+#ifndef KSU_PREINIT_COMPAT_LINUX_MOUNT_H
+#define KSU_PREINIT_COMPAT_LINUX_MOUNT_H
+
+#ifndef MS_RDONLY
+#define MS_RDONLY	1
+#define MS_NOSUID	2
+#define MS_NODEV	4
+#define MS_NOEXEC	8
+#define MS_SYNCHRONOUS	16
+#define MS_REMOUNT	32
+#define MS_MANDLOCK	64
+#define MS_DIRSYNC	128
+#define MS_NOSYMFOLLOW	256
+#define MS_NOATIME	1024
+#define MS_NODIRATIME	2048
+#define MS_BIND		4096
+#define MS_MOVE		8192
+#define MS_REC		16384
+#define MS_SILENT	32768
+#define MS_POSIXACL	(1 << 16)
+#define MS_UNBINDABLE	(1 << 17)
+#define MS_PRIVATE	(1 << 18)
+#define MS_SLAVE	(1 << 19)
+#define MS_SHARED	(1 << 20)
+#define MS_RELATIME	(1 << 21)
+#define MS_KERNMOUNT	(1 << 22)
+#define MS_I_VERSION	(1 << 23)
+#define MS_STRICTATIME	(1 << 24)
+#define MS_LAZYTIME	(1 << 25)
+#endif
+
+#endif /* KSU_PREINIT_COMPAT_LINUX_MOUNT_H */
diff --git a/kernel/preinit/runner/compat/prelude.h b/kernel/preinit/runner/compat/prelude.h
new file mode 100644
index 00000000..5028cb87
--- /dev/null
+++ b/kernel/preinit/runner/compat/prelude.h
@@ -0,0 +1,37 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * Build-time compatibility shims for the SukiSU preinit runner.
+ *
+ * The runner is a freestanding nolibc program compiled with the kernel's
+ * clang and -nostdinc; it is built against <objtree>/usr/include (the
+ * headers_install output of the kernel being built). On 4.19 those uapi
+ * headers predate clone3, but the vendored nolibc's sys_vfork() fallback
+ * still references struct clone_args / __NR_clone3 unconditionally.
+ *
+ * The runner never calls vfork() (it uses fork(), which goes through the
+ * legacy clone syscall on arm64 and works on 4.19), so these definitions
+ * only satisfy the compiler; they are not reachable at runtime.
+ */
+#ifndef KSU_PREINIT_COMPAT_PRELUDE_H
+#define KSU_PREINIT_COMPAT_PRELUDE_H
+
+#ifndef __NR_clone3
+#define __NR_clone3 435
+#endif
+
+#ifndef KSU_COMPAT_CLONE_ARGS_DEFINED
+#define KSU_COMPAT_CLONE_ARGS_DEFINED
+#define CLONE_ARGS_SIZE_VER0 64
+struct clone_args {
+	unsigned long long flags;
+	unsigned long long pidfd;
+	unsigned long long child_tid;
+	unsigned long long parent_tid;
+	unsigned long long exit_signal;
+	unsigned long long stack;
+	unsigned long long stack_size;
+	unsigned long long tls;
+};
+#endif
+
+#endif /* KSU_PREINIT_COMPAT_PRELUDE_H */
